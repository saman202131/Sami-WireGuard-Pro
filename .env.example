# REQUIRED: strong unique password, configure in Render Environment, not in source control
ADMIN_PASSWORD=replace-with-a-long-random-password
PORT=10000
SUPPORT_USERNAME=
CHANNEL_URL=
# If JSON file storage is used, attach a persistent disk mounted at /var/data on Render
DATA_DIR=/var/data
# Optional: set only when using Telegram Mini App identity validation and customer notifications
TELEGRAM_BOT_TOKEN=replace-in-render-environment-only
# Optional; normally generate via admin panel and set the same value on the bot host
# Keep enabled until real payment and provider sandbox integrations have been tested
TEST_MODE=true

# Optional: Telegram chat ID that should receive a notification when a customer submits a receipt
ADMIN_TELEGRAM_CHAT_ID=
